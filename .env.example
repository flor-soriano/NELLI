# Copia a .env (nunca se sube). Tu llave, creada en dev.meta.ai. Standard siempre; nunca contributor.
MODEL_API_KEY=
# Opcionales
# URLHAUS_KEY=            # llave gratuita de abuse.ch para «¿la liga ya está reportada?»
# NELLI_PROMPT_GUARD=     # ruta local al modelo Prompt Guard 2 (pesos abiertos) para la señal de inyección
# NELLI_TOPE_USD=100      # tope de gasto del proyecto
# NELLI_SAL=              # sal para el hash de orígenes (números/IPs) en logs
# NELLI_PROXY_CONFIANZA=  # IPs del proxy inverso (separadas por coma); solo de ellas se cree X-Forwarded-For. Sin esto, el tope por origen cuenta a todos como uno solo
